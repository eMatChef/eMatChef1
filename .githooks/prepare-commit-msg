#!/usr/bin/env bash
# Normalisiert Commit-Messages: filtert automatisch erzeugte Metadaten-Trailer
# (Co-Author-, Made-with- und Generated-by-Zeilen) heraus, damit nur
# redaktionell gepflegte Angaben in der sichtbaren Historie und in der
# Contributors-Liste landen. Normaler Message-Text bleibt unveraendert;
# entfernt werden nur Zeilen, die als Trailer beginnen.
#
# Args von Git: $1 = path to commit message file, $2 = source, $3 = SHA
set -euo pipefail

MSG_FILE="${1:-}"
[[ -n "$MSG_FILE" && -f "$MSG_FILE" ]] || exit 0

TOOLS='cursor|cursoragent|claude|anthropic|copilot|openai|chatgpt|codex|gemini'

# Trailer-Zeilen (nur am Zeilenanfang), die auf ein Tool/Modell verweisen
TRAILER_RE="^(Co-authored-by|Made-with|Generated-by|Generated[[:space:]]+(by|with))[:[:space:]].*(${TOOLS})"
# Generische Marker ohne Tool-Namen: Co-Author "AI"/"LLM"/"GPT" als eigenes Wort
GENERIC_RE='^Co-authored-by:.*([^[:alnum:]]|^)(AI|LLM|GPT)([^[:alnum:]]|$)'

if ! grep -qiE "$TRAILER_RE" "$MSG_FILE" && ! grep -qE "$GENERIC_RE" "$MSG_FILE" \
  && ! grep -qiE "noreply@anthropic\.com|cursoragent@cursor\.com" "$MSG_FILE"; then
  exit 0
fi

tmp="$(mktemp)"
grep -viE \
  -e "$TRAILER_RE" \
  -e 'noreply@anthropic\.com' \
  -e 'cursoragent@cursor\.com' \
  "$MSG_FILE" | grep -vE -e "$GENERIC_RE" >"$tmp" || true
mv "$tmp" "$MSG_FILE"
