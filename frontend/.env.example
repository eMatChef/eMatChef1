# --- Host-Umleitung (öffentliche QR-Subdomain) ---
# Wenn die SPA unter qr.ematchef.ch läuft: Login → App-Origin, Impressum/Datenschutz → Hauptseite.
# Leer lassen = keine Umleitung (lokale Entwicklung).

# Hostname (nur Host, ohne https://) der QR-Subdomain, z. B. qr.ematchef.ch
VITE_QR_PUBLIC_HOST=

# Origin der Login-/App-Instanz, z. B. https://app.ematchef.ch
VITE_APP_ORIGIN=

# Hauptseite mit Impressum/Datenschutz, z. B. https://ematchef.ch
VITE_MAIN_SITE_ORIGIN=https://ematchef.ch
