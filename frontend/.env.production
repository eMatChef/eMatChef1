# Nur für `npm run build` / Hostpoint-Upload (Vite mode=production).
# Bei Bedarf VITE_API_BASE / QR-Host anpassen (z. B. api-dev während Übergangsphase).
VITE_API_BASE=https://api.ematchef.ch
VITE_APP_ORIGIN=https://app.ematchef.ch
VITE_MAIN_SITE_ORIGIN=https://ematchef.ch
# Öffentliche QR-Subdomain (wenn DNS + Backend APP_PUBLIC_QR_URL stehen):
# VITE_QR_PUBLIC_HOST=qr.ematchef.ch
# Turnstile Site-Key (Cloudflare Dashboard) — diese Zeile darf NICHT mit # beginnen:
VITE_TURNSTILE_SITE_KEY=0x4AAAAAADAu0kLPWV3MmodS