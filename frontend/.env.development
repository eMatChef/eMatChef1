# Nur für `npm run dev` (Vite mode=development).
# API über Vite-Proxy → /api (siehe vite.config.ts) bzw. Nginx bei Docker.
VITE_RELATIVE_API=true
# Vite-Proxy-Ziel: lokal = Standard 127.0.0.1:8081. Im Docker-Frontend-Container setzt Compose backend:8081.
# VITE_API_PROXY_TARGET=http://backend:8081
VITE_APP_ORIGIN=https://app.ematchef.test
VITE_MAIN_SITE_ORIGIN=https://ematchef.test
VITE_QR_PUBLIC_HOST=qr.ematchef.test
VITE_DEVICES_HOST=devices.ematchef.test
# Cloudflare Turnstile Site-Key (leer = kein Widget, Backend ohne Secret)
# VITE_TURNSTILE_SITE_KEY=
# 1 = Widget ausblenden + kein Token (zu Backend TURNSTILE_SKIP_VERIFY=1 beim Testen)
# VITE_TURNSTILE_SKIP=1

# Auto-Logout (DEV): länger, damit Idle beim Entwickeln nicht stört; gleiche Events wie PROD
VITE_AUTOLOGOUT_TIMEOUT_MS=3600000
VITE_AUTOLOGOUT_WARNING_MS=300000
VITE_AUTOLOGOUT_ACTIVITY_THROTTLE_MS=3000
VITE_AUTOLOGOUT_REFRESH_INTERVAL_MS=900000
VITE_AUTOLOGOUT_ACTIVITY_EVENTS=click,keydown,scroll
