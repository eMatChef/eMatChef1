# Basis-Konfiguration (im Repo). Geheimnisse nur in .env.local (gitignored).
# Docker Compose setzt DATABASE_URL, JWT_*, CORS_* zur Laufzeit – diese Werte sind lokale Defaults.

APP_ENV=dev
APP_DEBUG=1
APP_SECRET=dev-not-for-production-change-with-app-secret-tool

DATABASE_URL="postgresql://mvuser:mvpass@127.0.0.1:5432/mvdb?serverVersion=16&charset=utf8"

JWT_PASSPHRASE=your-secret-passphrase-change-in-production

# Regex (Nelmio); in Produktion auf echte Origins anpassen oder in .env.local überschreiben
CORS_ALLOW_ORIGIN="^https?://(app\\.localhost|qr\\.localhost|localhost|127\\.0\\.0\\.1)(:[0-9]+)?$"

MAILER_DSN=null://null

# Optional: Fallback fcal API-Key. Bevorzugt: Verwaltung → Integrationen (Superadmin).
FCAL_API_KEY=

# Öffentliche QR-Seite (Subdomain). Leer = gleiche Basis wie APP_FRONTEND_URL.
APP_FRONTEND_URL=http://app.localhost
APP_PUBLIC_QR_URL=http://qr.localhost

# Cloudflare Turnstile (Registrierung). Leer = serverseitige Captcha-Prüfung aus (nur lokal).
TURNSTILE_SECRET_KEY=
# 1 = Captcha nicht prüfen (lokal testen trotz gesetztem Secret). Produktion: immer 0.
TURNSTILE_SKIP_VERIFY=0
