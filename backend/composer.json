{
    "name": "ematchef/backend",
    "type": "project",
    "description": "eMatChef Backend API",
    "license": "AGPL-3.0-or-later",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "api-platform/core": "^3.2",
        "doctrine/doctrine-bundle": "^2.11",
        "doctrine/doctrine-migrations-bundle": "^3.3",
        "doctrine/orm": "^2.16",
        "dompdf/dompdf": "^3.1",
        "endroid/qr-code": "^6.1",
        "gesdinet/jwt-refresh-token-bundle": "^1.5",
        "lexik/jwt-authentication-bundle": "^2.20",
        "mikehaertl/php-pdftk": "^0.13",
        "nelmio/cors-bundle": "^2.6",
        "symfony/console": "^6.4",
        "symfony/dotenv": "^6.4",
        "symfony/framework-bundle": "^6.4",
        "symfony/http-client": "^8.0",
        "symfony/mailer": "^8.0",
        "symfony/amazon-mailer": "^8.0",
        "symfony/rate-limiter": "^8.0",
        "symfony/runtime": "^6.4",
        "symfony/yaml": "^7.4"
    },
    "require-dev": {
        "dg/bypass-finals": "^1.9",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^11.5",
        "symfony/maker-bundle": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "DoctrineMigrations\\": "migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    }
}
