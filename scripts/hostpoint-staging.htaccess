# Staging: Hostpoint Passwortschutz + SPA-Fallback
# AuthUserFile: Secret STAGING_BASIC_AUTH_HTPASSWD_PATH_* (Hostpoint: /home/…/.htpasswds/htpasswd.…)
# Hostpoint-UI schreibt denselben Block; alles nach #@__HCP_END__@# bleibt bei UI-Änderungen erhalten.

Require valid-user
AuthType Basic
AuthName "eMatChef Staging"
AuthUserFile __AUTH_USER_FILE__

#@__HCP_END__@#
# Anything after the comment above is left alone

RewriteEngine On

# Fehlende Dateien unter /assets/ nicht durch index.html ersetzen — sonst liefert der Server
# text/html für *.js (SPA-Rewrite) und der Browser meldet MIME-/Modul-Fehler statt 404.
RewriteCond %{REQUEST_URI} ^/assets/ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ - [R=404,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
