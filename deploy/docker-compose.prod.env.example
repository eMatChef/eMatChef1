# Auf dem Server nach /opt/ematchef/prod/.env kopieren und Werte setzen (nicht committen).
# docker compose lädt .env automatisch für Variablen in docker-compose.override.yml

# Starkes DB-Passwort (muss zu POSTGRES_PASSWORD passen)
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# Symfony (openssl rand -hex 32)
APP_SECRET=CHANGE_ME_64_HEX_OR_RANDOM_STRING

# Lexik JWT
JWT_PASSPHRASE=CHANGE_ME_LONG_RANDOM_PASSPHRASE

# Optional: Hostpoint SMTP, sonst null://null
# MAILER_DSN=null://null
