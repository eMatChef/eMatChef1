# Variante A (empfohlen): Geheimnisse automatisch erzeugen:
#   bash deploy/init-prod-env.sh
#
# Variante B: Diese Datei nach .env kopieren und Platzhalter manuell setzen.
# docker compose lädt .env für Variablen in docker-compose.override.yml

POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
APP_SECRET=CHANGE_ME_64_HEX_OR_RANDOM_STRING
JWT_PASSPHRASE=CHANGE_ME_LONG_RANDOM_PASSPHRASE

# --- E-Mail (Symfony Mailer) ---
# Absender (sichtbar beim Empfänger). Reine Adresse oder "Name <mail@domain>".
MAILER_FROM="noreply@ematchef.ch"
# Optional: Reply-To (Antworten). Leer lassen oder z. B.:
# MAILER_REPLY_TO="support@ematchef.ch"
#
# Optional: Logo in HTML-Systemmails (absolute HTTPS-URL, z. B. https://ematchef.ch/favicon.svg).
# In docker-compose.override.yml als MAILER_BRAND_LOGO_URL an das backend durchreichen.
# MAILER_BRAND_LOGO_URL="https://ematchef.ch/favicon.svg"

# Transport: Weglassen oder null://null = kein SMTP (Mails landen unter var/app/mail_spool).
# Sonst native Symfony-DSN (User/Pass bzw. API-Key URL-encoden: @ → %40, : → %3A usw.).
#
# --- SendGrid (HTTPS-API, empfohlen z. B. wenn der VPS ausgehend SMTP 587 blockiert) ---
# Backend braucht Paket symfony/sendgrid-mailer (im Repo). In SendGrid: API Key mit „Mail Send“,
# Domain oder Single Sender authentifizieren; MAILER_FROM muss zu den verifizierten Absendern passen.
# Doku: https://docs.sendgrid.com/for-developers/sending-email/getting-started-email-api
#
# MAILER_DSN="sendgrid+api://SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@default"
#
# Sonderzeichen im Key: kompletten Key per URL-Encoding in die DSN legen (nur der Teil vor @default).
#
# --- Hostpoint (Control Panel → Mailbox), nur wenn SMTP vom Server aus erreichbar ist ---
# STARTTLS auf 587 (üblich):
# MAILER_DSN="smtp://MAILBOX%40ematchef.ch:DEIN_SMTP_PASSWORT@asmtp.mail.hostpoint.ch:587?encryption=tls"
#
# SSL auf 465:
# MAILER_DSN="smtps://MAILBOX%40ematchef.ch:DEIN_SMTP_PASSWORT@asmtp.mail.hostpoint.ch:465"
#
# Ohne Verschlüsselung (nur im internen Netz):
# MAILER_DSN="smtp://user:pass@relay.internal:25"
#
# Nach Änderung: Backend neu starten oder im Container:
#   php bin/console cache:clear --env=prod
#
# Fallback wenn MAILER_DSN null://null: Superadmin → Mail-Einstellungen (var/app/mail_outbound.json).
# Test: POST /api/mail/test-send (Superadmin), Body {"to":"deine@mail.de"}
# Oder im Container: php bin/console mailer:test deine@mail.de --env=prod
MAILER_DSN=null://null
