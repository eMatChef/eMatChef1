# Vorlage für Staging auf dem Develop-Droplet (eigener Ordner):
#   cp deploy/staging-droplet.env.example .env && nano .env && chmod 600 .env
#   chown "$(whoami):$(whoami)" .env && chmod 600 .env
#
# Typisch: /opt/ematchef/staging neben /opt/ematchef/develop (gleicher Hetzner-Server).
# Compose-Projekt: ematchef-staging (nicht ematchef-develop).
#
# Diese Datei ist nur eine Vorlage im Git. Die echte `.env` liegt auf dem Server
# (gitignored) und bleibt bei `git reset --hard` / deploy erhalten.

HOST_UID=1000
HOST_GID=1000

# --- JWT (Login) ---
# Eigene Keys/Passphrase für Staging (nicht dieselben Dateien wie develop, wenn Volumes getrennt).
# Prüfen:
#   docker compose -p ematchef-staging exec backend printenv JWT_PASSPHRASE
#
# Neu erzeugen: siehe deploy/regenerate-droplet-jwt.sh (Compose-Projekt beachten)
JWT_PASSPHRASE=your-secret-passphrase-change-for-staging

# Öffentliche URLs der Staging-Domains (HTTPS)
APP_FRONTEND_URL=https://app-staging.ematchef.ch
APP_PUBLIC_QR_URL=https://qr-staging.ematchef.ch
AUTH_COOKIE_DOMAIN=.ematchef.ch
AUTH_COOKIE_SECURE=1
# Dev-Tools auf Staging erlaubt (DB-Reset o. ä.) — bei Bedarf auf 0 setzen
EMATCHEF_DEV_TOOLS=1

# Regex für Nelmio CORS — Staging-Frontends
CORS_ALLOW_ORIGIN='^https://(staging\.ematchef\.ch|app-staging\.ematchef\.ch|qr-staging\.ematchef\.ch|devices-staging\.ematchef\.ch)$'

# Registrierung / Turnstile (optional): Staging-Hosts im Cloudflare-Widget erlauben
# TURNSTILE_SECRET_KEY=

# E-Mail: bestehende SES-Domain ematchef.ch wiederverwenden (kein neues AWS-Setup)
# MAILER_DSN=ses+api://ACCESS_KEY_ID:SECRET_ACCESS_KEY@default?region=eu-central-1
# MAILER_FROM=noreply@ematchef.ch
