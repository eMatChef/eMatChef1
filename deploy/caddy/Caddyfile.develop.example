# Develop-Droplet: API + App (Einstieg bare host) + qr/devices Hierarchie.
#
#   caddy validate --config /etc/caddy/Caddyfile && systemctl reload caddy
#
# Webroot: DEVELOP_APP_WEBROOT (z. B. /var/www/ematchef-app-develop)

api.dev.ematchef.ch, api-dev.ematchef.ch {
	reverse_proxy 127.0.0.1:8081
}

api.staging.ematchef.ch, api-staging.ematchef.ch {
	reverse_proxy 127.0.0.1:8082
}

# Develop-App: Einstieg https://dev.ematchef.ch (Login)
dev.ematchef.ch, app.dev.ematchef.ch, qr.dev.ematchef.ch, devices.dev.ematchef.ch,
app-dev.ematchef.ch, qr-dev.ematchef.ch, devices-dev.ematchef.ch {
	root * /var/www/ematchef-app-develop
	encode gzip
	try_files {path} /index.html
	file_server
}
