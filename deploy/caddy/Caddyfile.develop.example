# Beispiel Caddyfile für den Develop-Droplet (API + App-SPA).
# Auf dem Server z. B. nach /etc/caddy/Caddyfile übernehmen, anpassen, dann:
#   caddy validate --config /etc/caddy/Caddyfile && systemctl reload caddy
#
# Webroot muss zum Secret DEVELOP_APP_WEBROOT und zum rsync-Ziel passen.

api-dev.ematchef.ch {
	reverse_proxy 127.0.0.1:8081
}

# Nach DNS-Cutover: app-dev / qr-dev / devices-dev → diese Droplet-IP
app-dev.ematchef.ch, qr-dev.ematchef.ch, devices-dev.ematchef.ch {
	root * /var/www/ematchef-app-develop
	encode gzip
	try_files {path} /index.html
	file_server
}
