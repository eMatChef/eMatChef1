# Staging auf dem Develop-Droplet: API + App-Hierarchie + Basic Auth.
# Hash: caddy hash-password --plaintext '…'
# Webroot z. B. /var/www/ematchef-app-staging

api-staging.ematchef.ch {
	reverse_proxy 127.0.0.1:8082
}

app.staging.ematchef.ch, qr.staging.ematchef.ch, devices.staging.ematchef.ch {
	basic_auth {
		# user <caddy-hash>
		staging JDJhJDEwJ...ersetzen
	}
	root * /var/www/ematchef-app-staging
	encode gzip
	try_files {path} /index.html
	file_server
}

# Übergang von flat → Hierarchie
app-staging.ematchef.ch {
	redir https://app.staging.ematchef.ch{uri} permanent
}
qr-staging.ematchef.ch {
	redir https://qr.staging.ematchef.ch{uri} permanent
}
devices-staging.ematchef.ch {
	redir https://devices.staging.ematchef.ch{uri} permanent
}
staging.ematchef.ch {
	redir https://app.staging.ematchef.ch{uri} permanent
}
