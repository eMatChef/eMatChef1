# Staging-Hosts (oft auf dem Develop-Droplet). Basic Auth für App/QR/Devices.
# Hash: caddy hash-password --plaintext '…'
# Webroot z. B. /var/www/ematchef-app-staging
#
# Hinweis: api.staging steht typischerweise schon in Caddyfile.develop.example.

app.staging.ematchef.ch, qr.staging.ematchef.ch, devices.staging.ematchef.ch,
app-staging.ematchef.ch, qr-staging.ematchef.ch, devices-staging.ematchef.ch,
staging.ematchef.ch {
	basic_auth {
		# user <caddy-hash>
		staging JDJhJDEwJ...ersetzen
	}
	root * /var/www/ematchef-app-staging
	encode gzip
	try_files {path} /index.html
	file_server
}
