# Staging App-Hosts. API in Caddyfile.develop.example (gleicher Droplet).
# Optional: basic_auth ergänzen.
# Webroot z. B. /var/www/ematchef-app-staging

# Einstieg https://staging.ematchef.ch (Login)
staging.ematchef.ch, app.staging.ematchef.ch, qr.staging.ematchef.ch, devices.staging.ematchef.ch,
app-staging.ematchef.ch, qr-staging.ematchef.ch, devices-staging.ematchef.ch {
	root * /var/www/ematchef-app-staging
	encode gzip
	try_files {path} /index.html
	file_server
}
