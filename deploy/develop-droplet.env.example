# Vorlage für den Develop-Droplet: nach Repo-Root kopieren und anpassen:
#   cp deploy/develop-droplet.env.example .env && nano .env && chmod 600 .env
# Owner muss der Deploy-User sein (GitHub Actions / prod-update.sh), nicht root:
#   chown "$(whoami):$(whoami)" .env && chmod 600 .env
#
# Diese Datei ist nur eine Vorlage im Git. Die echte `.env` liegt auf dem Server
# (gitignored) und bleibt bei `git reset --hard` / deploy erhalten.

HOST_UID=1000
HOST_GID=1000

# --- Secrets (Compose-Override: leer = Backend sendet kein DB-Passwort) ---
# Muss zum bestehenden Postgres-Volume passen. Nicht neu würfeln, Volume nicht löschen.
# Wert suchen: docker inspect ematchef-develop-db-1 --format '{{range .Config.Env}}{{println .}}{{end}}'
POSTGRES_PASSWORD=CHANGE_ME_MUST_MATCH_EXISTING_VOLUME
APP_SECRET=CHANGE_ME

# --- JWT (Login) ---
# Die Passphrase MUSS zu den Dateien backend/config/jwt/*.pem auf DIESEM Server passen.
# Nur den Platzhalter lassen, aber Keys sind älter / mit anderer Passphrase erzeugt → Login scheitert.
#
# Prüfen, was der Container wirklich sieht:
#   docker compose -p ematchef-develop exec backend printenv JWT_PASSPHRASE
#
# Automatisch (Zufallspassphrase + neue Keys): siehe deploy/regenerate-droplet-jwt.sh
# Oder manuell (alle bestehenden JWT/Refresh-Tokens auf diesem Env werden ungültig):
#   nano .env   # JWT_PASSPHRASE=<lang zufällig>
#   docker compose -p ematchef-develop exec backend php bin/console lexik:jwt:generate-keypair --overwrite -n
#   … dann Backend neu starten (deploy/prod-update.sh up o. ä.)
JWT_PASSPHRASE=your-secret-passphrase-change-in-production

# Öffentliche URLs — Einstieg bare host (Login), QR unter qr.dev
APP_FRONTEND_URL=https://dev.ematchef.ch
APP_PUBLIC_QR_URL=https://qr.dev.ematchef.ch
APP_MAIN_SITE_ORIGIN=https://ematchef.ch
AUTH_COOKIE_DOMAIN=.ematchef.ch
AUTH_COOKIE_SECURE=1
# DB-Reset / Aktivitäten löschen auf api-dev (Backend läuft mit APP_ENV=prod)
EMATCHEF_DEV_TOOLS=1

# Regex für Nelmio CORS — bare host + Hierarchie + Übergangs-Hosts
CORS_ALLOW_ORIGIN='^https://((app|qr|devices)\.dev\.ematchef\.ch|(dev|app-dev|qr-dev|devices-dev)\.ematchef\.ch)$'

# Registrierung / Turnstile (optional): alternativ nur in backend/.env.local auf dem Server
# TURNSTILE_SECRET_KEY=

# Google OAuth (Web-Client, Dev — nicht Prod-Secret).
# Weiterleitungs-URIs im selben Client:
#   https://dev.ematchef.ch/api/auth/google/callback
#   https://dev.ematchef.ch/api/auth/google/gmail/callback
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=
# GOOGLE_GMAIL_REDIRECT_URI=

# E-Mail (optional): alternativ MAILER_* in backend/.env.local — nie nur in backend/.env
# (backend/.env ist im Repo versioniert und wird bei reset überschrieben)
# MAILER_DSN=null://null
