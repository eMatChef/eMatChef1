# Vorlage für den Develop-Droplet: nach Repo-Root kopieren und anpassen:
#   cp deploy/develop-droplet.env.example .env && nano .env && chmod 600 .env
#
# Diese Datei ist nur eine Vorlage im Git. Die echte `.env` liegt auf dem Server
# (gitignored) und bleibt bei `git reset --hard` / deploy erhalten.

HOST_UID=1000
HOST_GID=1000

# Muss zur Passphrase passen, mit der `config/jwt/*.pem` erzeugt wurden (lexik:jwt:generate-keypair).
JWT_PASSPHRASE=your-secret-passphrase-change-in-production

# Öffentliche URLs eurer Dev-Domains (HTTPS)
APP_FRONTEND_URL=https://app-dev.ematchef.ch
APP_PUBLIC_QR_URL=https://qr-dev.ematchef.ch
AUTH_COOKIE_DOMAIN=.ematchef.ch
AUTH_COOKIE_SECURE=1

# Regex für Nelmio CORS — an eure echten Hostnamen anpassen
CORS_ALLOW_ORIGIN='^https://(dev\.ematchef\.ch|app-dev\.ematchef\.ch|qr-dev\.ematchef\.ch)$'

# Registrierung / Turnstile (optional): alternativ nur in backend/.env.local auf dem Server
# TURNSTILE_SECRET_KEY=

# E-Mail (optional): alternativ MAILER_* in backend/.env.local — nie nur in backend/.env
# (backend/.env ist im Repo versioniert und wird bei reset überschrieben)
# MAILER_DSN=null://null
